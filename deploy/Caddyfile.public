{
	# PUBLIC mode (on the VM): Caddy on 80/443, automatic Let's Encrypt for
	# {$AO_SITE_ADDRESS} (the bot's fleet hostname, e.g. koma.binary-badger.xyz).
	#
	# M8a: bots are AUTHORIZE-ONLY. Authentication happens at the fleet SSO
	# portal (auth.binary-badger.xyz, Cloud Run); it mints a domain-wide JWT
	# cookie signed with the shared JWT_SHARED_KEY, which the policy below
	# validates statelessly. No portal, no OAuth client, no per-bot Console steps.
	order authorize before basicauth

	security {
		authorization policy mypolicy {
			# Unauthenticated users are sent straight into the Google flow at the
			# fleet portal (root mount → /oauth2/google, no /auth prefix).
			set auth url {$AO_AUTH_URL}
			crypto key verify {env.JWT_SHARED_KEY}

			# EMAIL ALLOWLIST — acl default is deny-unless-allowed. {$ALLOWED_EMAILS}
			# is PARSE-TIME substitution: a space-separated value splats into a
			# multi-value match ({env.…} would not). Empty/unset → Caddy fails to
			# start (acceptable: the VM .env always sets it from dashboard-allowlist).
			acl rule {
				comment fleet allowlist
				match email {$ALLOWED_EMAILS}
				allow stop log info
			}
			acl rule {
				comment default deny
				match any
				deny log warn
			}

			validate bearer header
			inject headers with claims
		}
	}
}

{$AO_SITE_ADDRESS} {
	# Public: automatic Let's Encrypt (HTTP-01 needs port 80 reachable — the
	# firewall opens 80+443).

	# Daemon API (incl. SSE /api/v1/events) — authorized, proxied to the daemon.
	handle /api/* {
		authorize with mypolicy
		reverse_proxy ao:8080 {
			# SSE belt-and-suspenders: stream /api/v1/events without buffering.
			flush_interval -1
		}
	}

	# Admin backend (version / update / secret rotation) — authorized, proxied
	# to the co-located admin server in the ao container.
	handle /admin/api/* {
		authorize with mypolicy
		reverse_proxy ao:8090
	}

	# Everything else: the static monitoring SPA — also behind the auth gate.
	handle {
		authorize with mypolicy
		root * /srv
		file_server
	}
}
