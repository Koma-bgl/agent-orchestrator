{
	# Cloud Run terminates TLS and routes to $PORT (8080). Plain HTTP inside;
	# caddy-security builds absolute URLs from X-Forwarded-Proto/Host, which
	# Cloud Run sets — so redirects/callbacks come out as https://auth.<domain>/…
	http_port 8080
	auto_https off
	order authenticate before respond

	security {
		oauth identity provider google {
			realm google
			driver google
			client_id {env.GOOGLE_CLIENT_ID}
			client_secret {env.GOOGLE_CLIENT_SECRET}
			scopes openid email profile
		}

		authentication portal myportal {
			crypto default token lifetime 3600
			crypto key sign-verify {env.JWT_SHARED_KEY}
			enable identity provider google
			# Fleet-wide session: scope EVERY portal cookie (incl. the access token)
			# to the parent domain so every *.binary-badger.xyz host receives it.
			# (v1.1.31: `cookie domain` works — the #481 break is a 1.1.32+ thing;
			# this version also predates the #471 delete-cookie regression.)
			# Invariant: nothing untrusted is ever hosted under binary-badger.xyz.
			cookie domain binary-badger.xyz
			# Conventional role grant; authorization happens bot-side.
			transform user {
				match realm google
				action add role authp/user
			}
		}
	}
}

:8080 {
	authenticate with myportal
}
